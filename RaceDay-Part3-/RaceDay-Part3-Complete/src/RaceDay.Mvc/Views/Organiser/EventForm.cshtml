@model EventFormViewModel
@{ ViewData["Title"] = Model.EventId == 0 ? "Create event" : "Edit event"; var editing = Model.EventId != 0; }
<div class="form-shell wide"><span class="eyebrow">EVENT SETUP</span><h1 class="section-title">@(editing ? "Edit event" : "Create an event")</h1>
<form asp-action="@(editing ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="EventId" type="hidden" />
    <div class="mb-3"><label asp-for="Name" class="form-label">Event name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label">Date and time</label><input asp-for="EventDate" type="datetime-local" class="form-control" /></div>
    <div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control" type="number" step="0.01" /></div>
    <div class="col-md-6 mb-3"><label asp-for="EventTypeId" class="form-label">Event type</label><select asp-for="EventTypeId" class="form-select"><option value="1">Run</option><option value="2">Walk</option><option value="3">Cycle</option></select></div></div>
    <div class="mb-4"><label asp-for="BannerImage" class="form-label">Event banner image</label><input asp-for="BannerImage" type="file" accept="image/*" class="form-control" /><small class="text-muted">Image files only, maximum 5 MB. Azure Blob Storage must be configured in the API.</small></div>
    <button class="btn btn-race">Save event</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form></div>

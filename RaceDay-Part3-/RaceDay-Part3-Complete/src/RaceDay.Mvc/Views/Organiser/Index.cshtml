@model List<OrganiserEventSummary>
@{ ViewData["Title"] = "Organiser dashboard"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><span class="eyebrow">CONTROL CENTRE</span><h1 class="section-title">Organiser dashboard</h1><p class="text-muted mb-0">Manage your events and race-day operations.</p></div><a class="btn btn-race" asp-action="CreateEvent">+ Create event</a></div>
@if (ViewBag.ApiError is string error && !string.IsNullOrWhiteSpace(error)) { <div class="alert alert-warning">@error</div> }
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>YOUR EVENTS</span><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat-card"><span>UPCOMING EVENTS</span><strong>@ViewBag.UpcomingCount</strong></div></div><div class="col-md-4"><div class="stat-card"><span>NEXT EVENT</span><strong>@ViewBag.NextEventDate</strong></div></div></div>
<h2 class="h4 mb-3">Event management</h2>
<div class="row g-3">
@foreach (var summary in Model)
{
    var e = summary.Event;
    <div class="col-lg-6"><div class="event-card p-3 h-100">
        <div class="d-flex justify-content-between"><span class="type-pill">@e.GetProperty("eventType").GetString()</span><span class="text-muted small">@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</span></div>
        <h3 class="h5 mt-2">@e.GetProperty("name").GetString()</h3><p class="text-muted">@e.GetProperty("location").GetString() · @e.GetProperty("distanceKm").GetDecimal().ToString("0.##") km</p>
        <p class="small fw-bold">@summary.EnrolmentCount enrolment(s)</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-outline-dark" asp-action="EditEvent" asp-route-id="@e.GetProperty("eventId").GetInt32()">Edit</a>
            <a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-id="@e.GetProperty("eventId").GetInt32()">Categories</a>
            <a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-id="@e.GetProperty("eventId").GetInt32()">Enrolments</a>
            <a class="btn btn-sm btn-outline-dark" asp-action="Results" asp-route-id="@e.GetProperty("eventId").GetInt32()">Results</a>
            <form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()" /><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form>
        </div>
    </div></div>
}
</div>
@if (Model.Count == 0) { <div class="empty-state">No events are currently listed. Create your first event to get started.</div> }
